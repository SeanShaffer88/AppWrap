<Window x:Class="AppWrap.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AppWrap" Width="760" Height="560" MinWidth="680" MinHeight="560" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable, Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="32,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Accent}" Margin="0,0,14,0">
            <Viewbox Margin="10"><Path Data="M 2,7 L 12,2 22,7 22,19 12,24 2,19 Z M 2,7 L 12,12 22,7 M 12,12 L 12,24 M 7,4.5 L 17,9.5" Stroke="{DynamicResource AccentText}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox>
          </Border>
          <StackPanel><TextBlock Text="AppWrap" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Your app. Ready to share." FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel>
        </StackPanel>
        <Border Grid.Column="1" x:Name="Formats" Padding="4" CornerRadius="12" Background="{DynamicResource InputSurface}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal"><RadioButton x:Name="StandardMode" Content="Installer" Style="{DynamicResource FormatChoice}" IsChecked="True" Checked="ModeChanged" AutomationProperties.AutomationId="ModeStandard"/><RadioButton x:Name="PortableMode" Content="Portable app" Style="{DynamicResource FormatChoice}" Checked="ModeChanged" AutomationProperties.AutomationId="ModePortable"/><RadioButton x:Name="BothMode" Content="Both" Style="{DynamicResource FormatChoice}" Checked="ModeChanged" AutomationProperties.AutomationId="ModeBoth"/></StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="32,24,32,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><TextBlock x:Name="StepLabel" Foreground="{DynamicResource StepAccent}" FontSize="13" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="StepTopic" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="13"/></Grid>
      <ProgressBar x:Name="Steps" Grid.Row="1" Height="4" Margin="0,8,0,18" Foreground="{DynamicResource StepAccent}" Background="{DynamicResource InputSurface}" BorderThickness="0"/>
      <StackPanel Grid.Row="2"><TextBlock x:Name="Question" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="Hint" Foreground="{DynamicResource Muted}" FontSize="14" LineHeight="21" Margin="0,8,0,16"/></StackPanel>
      <ContentControl x:Name="Page" Grid.Row="3" VerticalContentAlignment="Top"/>
      <StackPanel Grid.Row="4"><TextBlock x:Name="Error" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Error}" Margin="0,12,0,0" AutomationProperties.AutomationId="Error" AutomationProperties.LiveSetting="Assertive"/><Expander x:Name="Details" Header="Show details" Foreground="{DynamicResource Muted}" Visibility="Collapsed" Margin="0,8,0,0"><TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ErrorDetails"/></Expander></StackPanel>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Button x:Name="CancelButton" Content="Cancel" Padding="14,10" HorizontalAlignment="Left" Click="CancelClick" AutomationProperties.AutomationId="Cancel"/><TextBlock Text="Appearance" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,8,0"/><ComboBox x:Name="ThemePicker" Width="160" FontSize="13" MinHeight="40" VerticalAlignment="Center" SelectionChanged="ThemeChanged" AutomationProperties.AutomationId="Appearance" AutomationProperties.Name="Appearance"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BackButton" Content="Back" Padding="14,10" Margin="0,0,8,0" Click="BackClick" AutomationProperties.AutomationId="Back"/><Button x:Name="NextButton" Content="Next" MinWidth="110" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Click="NextClick" IsDefault="True" AutomationProperties.AutomationId="Next"/></StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
